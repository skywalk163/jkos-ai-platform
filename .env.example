# DSH AI 中台 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ─── 数据库 ───
# SQLite (默认)
DSH_DB_PATH=/var/dsh/dsh.db

# PostgreSQL (可选)
# DSH_PG_HOST=localhost
# DSH_PG_PORT=5432
# DSH_PG_DB=dsh_ai
# DSH_PG_USER=dsh_user
# DSH_PG_PASSWORD=your_password

# ─── LLM ───
# DeepSeek (默认)
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# OpenAI (可选)
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4

# ─── 缓存 ───
# Memory (默认)
DSH_CACHE_BACKEND=memory

# Redis (可选)
# DSH_REDIS_URL=redis://localhost:6379/0

# ─── 事件总线 ───
# 内嵌 (默认)
DSH_BUS_BACKEND=embedded

# NATS (可选)
# DSH_NATS_URL=nats://localhost:4222

# ─── 通知 ───
# 企业微信
# DSH_WECOM_CORPID=xxx
# DSH_WECOM_CORPSECRET=xxx
# DSH_WECOM_AGENTID=xxx

# 钉钉
# DSH_DINGTALK_APPKEY=xxx
# DSH_DINGTALK_APPSECRET=xxx

# ─── 认证 ───
DSH_JWT_SECRET=your-jwt-secret
DSH_JWT_EXPIRES_IN=86400

# ─── 智能中枢（harness sidecar，M16）───
# 默认关闭；开启后 /api/v1/harness/* 与 /harness/ui/* 才挂载
JKOS_HARNESS_ENABLED=false
# harness 运行家目录（profiles / 会话持久化均落在此目录）
DSH_HOME=/data/dsh/harness-home
# SDK 运行时选择：
#   留空 = 用 SDK 自带 bundled runtime（Windows/macOS/Linux 有官方 wheel）
#   填路径 = 用指定 launcher（FreeBSD 无 runtime wheel，必须走源码构建的 dsh）
# JKOS_HARNESS_DSH_BIN=/data/dsh/harness/dsh-jkos.sh
JKOS_HARNESS_PROVIDER=deepseek-official
JKOS_HARNESS_MODEL=deepseek-v4-flash
# 会话工作区根目录（留空则用 $DSH_HOME/workspace）
# JKOS_HARNESS_WORKSPACE=/data/dsh/harness-home/workspace
# SDK 来源：pypi（默认）| local（从锁定 checkout 安装，协议漂移兜底）
JKOS_HARNESS_SDK_SOURCE=pypi
# Web UI 上游（harness 只监听 loopback，JKOS 经 127.0.0.1 反代）
JKOS_HARNESS_UI_BASE_URL=http://127.0.0.1:3080
# harness Web UI 访问令牌（必填才能访问 UI）：取自 dsh web 启动输出的 ?token= 值
# JKOS_HARNESS_UI_TOKEN=
# ToolBridge 上游：harness 经此处回调 JKOS 的 MCP 端点（由 MCP 服务提供）
JKOS_HARNESS_MCP_URL=http://127.0.0.1:3000/mcp

# 中枢 LLM 凭据（由 JKOS 注入 harness 子进程，harness 不落密钥文件）
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ToolBridge 调 JKOS /mcp 的令牌（供 harness 侧读取，不写入配置文件）
# JKOS_MCP_TOKEN=your-jkos-token

# ─── 日志 ───
DSH_LOG_LEVEL=INFO
